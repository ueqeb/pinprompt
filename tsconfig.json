{
	"compilerOptions": {
		"target": "es2022",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"lib": ["es2022", "dom", "dom.iterable"],
		"types": ["node"],
		"strict": true,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"noEmit": true
	},
	"include": ["src", "vite.config.ts"]
}
